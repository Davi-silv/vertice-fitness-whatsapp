{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/api.php", "destination": "/api/chat" },
    { "source": "/index.php", "destination": "/index.html" },
    { "source": "/admin", "destination": "/gestao-local.html" },
    { "source": "/admin/(.*)", "destination": "/gestao-local.html" },
    { "source": "/login", "destination": "/gestao-local.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
