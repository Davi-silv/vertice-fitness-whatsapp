{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "echo 'Express on Vercel'",
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,gestao-local.html,assets/**,public/**,database/**,server/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
